{
  "name": "play-ssg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/prepare.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node ../scripts/prepare.mjs",
    "build": "tsc -b && vite build",
    "prebuild:deploy": "node ../scripts/prepare.mjs --deploy",
    "build:deploy": "tsc -b && vite build --mode deploy",
    "deploy": "node ../scripts/deploy-ssg.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc --noEmit && vitest run",
    "test:browser": "playwright test --config tests/config/playwright.browser.config.ts",
    "test:cdn": "playwright test --config tests/config/playwright.cdn.config.ts",
    "test:loading": "playwright test --config tests/config/playwright.loading.config.ts",
    "test:pwa": "playwright test --config tests/config/playwright.pwa.config.ts",
    "test:bundled": "playwright test --config tests/config/playwright.bundled.config.ts",
    "test:desktop": "playwright test --config tests/config/playwright.desktop.config.ts",
    "test:e2e": "npm run test:browser && npm run test:cdn && npm run test:loading && npm run test:pwa && npm run test:bundled && npm run test:desktop"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "fflate": "0.8.3",
    "hash-wasm": "4.12.0",
    "i18next": "^26.5.11",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.9",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "GPL-3.0"
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ky-play-ssg",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build:deploy"
  },
  "vars": {
    "VITE_WEB_URL": "https://play.kuangye.team/",
    "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
    "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
    "VITE_EMULATOR_CDN_URL": "https://cdn.emulatorjs.org/4.2.3"
  }
}

# Local Vite development port; not used in production.
WEB_PORT=5173
 
# Empty uses bundled resources; deploy uses the official CDN. A custom release URL overrides both.
VITE_EMULATOR_CDN_URL=

# Public web address and desktop release discovery (empty uses the official site and GitHub release).
VITE_WEB_URL=
VITE_CLIENT_DOWNLOAD_URL=
VITE_API_LATEST=https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json

# EmulatorJS archive from prepare in .env.json; mirrors must provide the same release.
EMULATORJS_ARCHIVE_URL=https://github.com/EmulatorJS/EmulatorJS/releases/download/v4.2.3/4.2.3.7z

# Docker settings from compose.root in .env.json.
SERVER_PORT=8080
NPM_REGISTRY=https://registry.npmjs.org/

# Frontend build arguments from compose.ssg. Empty uses bundled resources; custom release URLs omit /data/.
VITE_EMULATOR_CDN_URL=

# Public web address and desktop release discovery (empty uses the official site and GitHub release).
VITE_WEB_URL=
VITE_CLIENT_DOWNLOAD_URL=
VITE_API_LATEST=https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json

{
  "desc": [
    "prepare: EmulatorJS archive download URL; included in the root .env.",
    "local: local development; generates ssg/.env.local.",
    "production: regular production builds; generates ssg/.env.production. Cloudflare deployment uses wrangler.ssg.vars instead.",
    "compose: Docker deployment; root contains the port and npm registry, ssg contains frontend build arguments.",
    "wrangler: overrides for ssg/wrangler.jsonc; Cloudflare frontend build settings come from vars (VITE_*), with defaults in ssg/wrangler.jsonc.example. VITE_* directly under wrangler.ssg are also mapped into vars; explicit wrangler.ssg.vars values take precedence.",
    "desktop: Tauri updater, signing and release settings; generates app/.env and ssg/.env.desktop (VITE_* only). Process environment variables take precedence. Set local secrets in .env.json or process env, CI secrets in GitHub Secrets; never put secrets in example files.",
    "VITE_API_LATEST: browser-accessible latest.json release manifest (version and platforms); custom endpoints must allow CORS. VITE_* values are public and embedded at build time.",
    "cache: reusable build and download caches live in temp/cache; CARGO_TARGET_DIR is relative to the repository root for desktop commands."
  ],
  "prepare": {
    "EMULATORJS_ARCHIVE_URL": "https://github.com/EmulatorJS/EmulatorJS/releases/download/v4.2.3/4.2.3.7z"
  },
  "local": {
    "ssg": {
      "WEB_PORT": 5173,
      "VITE_WEB_URL": "https://play.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
      "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
      "VITE_EMULATOR_CDN_URL": ""
    }
  },
  "production": {
    "ssg": {
      "VITE_WEB_URL": "https://play.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
      "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
      "VITE_EMULATOR_CDN_URL": "https://cdn.emulatorjs.org/4.2.3"
    }
  },
  "compose": {
    "root": {
      "SERVER_PORT": 8080,
      "NPM_REGISTRY": "https://registry.npmjs.org/"
    },
    "ssg": {
      "VITE_WEB_URL": "https://play.kuangye.team/",
      "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
      "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
      "VITE_EMULATOR_CDN_URL": ""
    }
  },
  "desktop": {
    "RELEASE_VERSION": "",
    "RELEASE_NOTES": "",
    "CARGO_TARGET_DIR": "temp/cache/cargo",
    "GITHUB_REPOSITORY": "kuangye-team/ky-play",
    "VITE_WEB_URL": "https://play.kuangye.team/",
    "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
    "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
    "VITE_EMULATOR_CDN_URL": "",
    "TAURI_UPDATER_URL": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
    "TAURI_UPDATER_PUBLIC_KEY": "",
    "TAURI_SIGNING_PRIVATE_KEY": "",
    "TAURI_SIGNING_PRIVATE_KEY_PASSWORD": "",
    "TAURI_RELEASE_BASE_URL": "",
    "APPLE_SIGNING_IDENTITY": "",
    "APPLE_ID": "",
    "APPLE_PASSWORD": "",
    "APPLE_TEAM_ID": ""
  },
  "wrangler": {
    "ssg": {
      "vars": {
        "VITE_WEB_URL": "https://play.kuangye.team/",
        "VITE_CLIENT_DOWNLOAD_URL": "https://github.com/kuangye-team/ky-play/releases/latest",
        "VITE_API_LATEST": "https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json",
        "VITE_EMULATOR_CDN_URL": "https://cdn.emulatorjs.org/4.2.3"
      }
    }
  }
}

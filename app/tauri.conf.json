{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ky Play",
  "version": "../package.json",
  "identifier": "team.kuangye.play",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ssg/desktop-dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "拾光 · Oasis",
      "hiddenTitle": true,
      "titleBarStyle": "Transparent",
      "backgroundColor": "#f0f4ec",
      "theme": "Light",
      "width": 1280,
      "height": 820,
      "minWidth": 800,
      "minHeight": 600,
      "devtools": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": { "../ssg/public/emulatorjs/": "emulatorjs/" },
    "category": "Game",
    "shortDescription": "Your personal game library",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["ky-play"] } },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}

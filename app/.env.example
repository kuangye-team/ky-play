# Generated from desktop in the root .env.json; process env takes precedence.
# Optional release metadata and build cache (relative to the repository root).
# RELEASE_VERSION=1.0.0
# RELEASE_NOTES=Release notes shown in the update manifest
# CARGO_TARGET_DIR=temp/cache/cargo
# GITHUB_REPOSITORY=kuangye-team/ky-play
# HTTP or HTTPS URL serving app/dist/latest.json (GitHub Releases or your own static host).
TAURI_UPDATER_URL=https://github.com/kuangye-team/ky-play/releases/latest/download/latest.json
# Paste the contents of the .pub file, not its path. Required for release builds.
TAURI_UPDATER_PUBLIC_KEY=
# Private key contents or absolute path. Required for release builds.
# Set in the root .env.json desktop section or process env; never commit secrets here.
TAURI_SIGNING_PRIVATE_KEY=
# Password for the private key. Leave empty for an unencrypted key.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# Optional HTTP or HTTPS installer/update download directory. Empty uses GitHub Releases.
TAURI_RELEASE_BASE_URL=
# Empty uses bundled resources. A custom CDN must allow requests from desktop webviews.
VITE_EMULATOR_CDN_URL=
